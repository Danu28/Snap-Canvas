{
  "name": "snapcanvas",
  "version": "1.4.0",
  "description": "Chrome extension (MV3) for capturing and annotating screenshots — full page, visible area, selected area, element capture with lossless PNG.",
  "type": "module",
  "license": "MIT",
  "author": "SnapCanvas Contributors",
  "keywords": ["chrome-extension", "screenshot", "annotation", "capture", "mv3"],
  "repository": {
    "type": "git",
    "url": "https://github.com/example/snap-canvas"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/bug-report.test.mjs tests/scroll-zoom-removed.test.mjs tests/enhancements.test.mjs",
    "test:bug": "node --test tests/bug-report.test.mjs",
    "test:zoom": "node --test tests/scroll-zoom-removed.test.mjs",
    "test:enh": "node --test tests/enhancements.test.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,css,html,json,yml}\"",
    "format:check": "prettier --check \"**/*.{js,css,html,json,yml}\""
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  }
}
