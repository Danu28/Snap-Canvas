{
  "manifest_version": 3,
  "name": "SnapCanvas",
  "description": "Capture full page, visible area, or selected area screenshots and annotate them.",
  "version": "1.3.0",
  "permissions": [
    "activeTab",
    "downloads",
    "clipboardWrite",
    "scripting",
    "storage",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "SnapCanvas",
    "default_popup": "popup.html"
  },
  "commands": {
    "full-page": {
      "suggested_key": {
        "default": "Ctrl+Shift+1"
      },
      "description": "Capture full page"
    },
    "visible-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+2"
      },
      "description": "Capture visible area"
    },
    "selected-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+3"
      },
      "description": "Capture selected area"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  }
}
